# Set these as process environment variables before starting Spring Boot.
SMARTWASTE_PORT=8080
SMARTWASTE_DB_URL=jdbc:mysql://127.0.0.1:3306/smart_waste?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8
SMARTWASTE_DB_USERNAME=smartwaste
SMARTWASTE_DB_PASSWORD=
# Required: a private, randomly generated signing key of at least 32 bytes.
SMARTWASTE_JWT_SECRET=
SMARTWASTE_REDIS_HOST=127.0.0.1
SMARTWASTE_REDIS_PORT=6379
SMARTWASTE_REDIS_PASSWORD=
SMARTWASTE_REDIS_DATABASE=0
SMARTWASTE_RABBITMQ_HOST=127.0.0.1
SMARTWASTE_RABBITMQ_PORT=5672
SMARTWASTE_RABBITMQ_USERNAME=smartwaste
SMARTWASTE_RABBITMQ_PASSWORD=
SMARTWASTE_RABBITMQ_VHOST=/
SMARTWASTE_AMAP_WEB_KEY=
SMARTWASTE_AMAP_JS_KEY=
SMARTWASTE_AMAP_SECURITY_JS_CODE=
# RAG gateway and standalone Java 17 service: same random token in both processes (32+ characters).
SMARTWASTE_RAG_URL=http://127.0.0.1:8081
SMARTWASTE_RAG_PORT=8081
SMARTWASTE_RAG_INTERNAL_TOKEN=
# Absolute writable directory recommended; preserve this directory together with both indexes.
SMARTWASTE_RAG_DATA_DIR=./data/knowledge
SMARTWASTE_AI_BASE_URL=https://api.openai.com
SMARTWASTE_AI_API_KEY=
# Final-answer model; choose independently from the lightweight query model below.
SMARTWASTE_CHAT_MODEL=gpt-4o-mini
# Query rewriting and multi-query expansion: one lightweight model call per question.
SMARTWASTE_QUERY_ENABLED=true
SMARTWASTE_QUERY_MODEL=gpt-4o-mini
# Optional: separate query provider; omitted values inherit SMARTWASTE_AI_BASE_URL/API_KEY.
# SMARTWASTE_QUERY_BASE_URL=https://api.openai.com
# SMARTWASTE_QUERY_API_KEY=
# Includes the original question; valid range: 1-5. Simple questions may use fewer.
SMARTWASTE_QUERY_MAX_QUERIES=5
SMARTWASTE_QUERY_TIMEOUT_MILLIS=15000
SMARTWASTE_QUERY_MAX_TOKENS=700
SMARTWASTE_RETRIEVAL_TOP_K=10
SMARTWASTE_RETRIEVAL_CANDIDATES=40
SMARTWASTE_RETRIEVAL_EVIDENCE=6
# Optional: separate OpenAI-compatible embedding provider (base URL excludes /v1).
# If omitted, embedding base URL and key inherit the chat provider settings.
# SMARTWASTE_EMBEDDING_BASE_URL=https://api.openai.com
# SMARTWASTE_EMBEDDING_API_KEY=
SMARTWASTE_EMBEDDING_MODEL=text-embedding-3-small
SMARTWASTE_ES_URL=http://127.0.0.1:9200
SMARTWASTE_ES_API_KEY=
SMARTWASTE_ES_INDEX=smartwaste-knowledge-v1
SMARTWASTE_CHROMA_URL=http://127.0.0.1:8000
SMARTWASTE_CHROMA_TOKEN=
SMARTWASTE_CHROMA_TENANT=default_tenant
SMARTWASTE_CHROMA_DATABASE=default_database
SMARTWASTE_CHROMA_COLLECTION=smartwaste-knowledge-v1
# Full URL of a Jina/Cohere-compatible reranking endpoint, including /v1/rerank.
SMARTWASTE_RERANK_URL=
SMARTWASTE_RERANK_API_KEY=
SMARTWASTE_RERANK_MODEL=jina-reranker-v2-base-multilingual
SMARTWASTE_RERANK_MIN_SCORE=0.25
SMARTWASTE_VECTOR_MAX_DISTANCE=0.45
# Optional first-start administrator creation (only when employee table is empty).
SMARTWASTE_ADMIN_USERNAME=
SMARTWASTE_ADMIN_PASSWORD=
# Independent FastAPI / ResNet18 service; same private token in both processes (32+ characters).
SMARTWASTE_VISION_URL=http://127.0.0.1:8082
SMARTWASTE_VISION_HOST=127.0.0.1
SMARTWASTE_VISION_PORT=8082
SMARTWASTE_VISION_INTERNAL_TOKEN=
SMARTWASTE_VISION_MAX_BYTES=5242880
SMARTWASTE_VISION_READ_TIMEOUT_MILLIS=20000
SMARTWASTE_VISION_DEVICE=cpu
SMARTWASTE_VISION_CONFIDENCE_THRESHOLD=0.65
SMARTWASTE_VISION_MAX_PIXELS=24000000
SMARTWASTE_VISION_TORCH_THREADS=2
# Optional absolute path; defaults to vision-service/checkpoints/best.pt.
# SMARTWASTE_VISION_CHECKPOINT=D:/models/smartwaste/best.pt
